<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" root="true" preserve.model.version="true" xsi:schemaLocation="http://maven.apache.org/POM/4.2.0 https://maven.apache.org/xsd/maven-4.2.0.xsd">
  <modelVersion>4.2.0</modelVersion>

  <groupId>org.apache.maven.its.gh13644</groupId>
  <artifactId>gh13644-plugin</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>GH-13644 Test Plugin — uses maven-plugin-mixin</name>

  <properties>
    <javaVersion>17</javaVersion>
    <mavenVersion>${maven-version}</mavenVersion>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-core</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-di</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <mixins>
    <mixin>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-mixin</artifactId>
      <version>${maven-version}</version>
      <classifier>mixin</classifier>
    </mixin>
  </mixins>
</project>
