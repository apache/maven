<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.its.mng12534</groupId>
  <artifactId>mng12534-plugin</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>MNG-12534 Test Plugin</name>
  <properties>
    <javaVersion>17</javaVersion>
    <mavenVersion>${maven-version}</mavenVersion>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-core</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-api-di</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.apache.maven</groupId>
              <artifactId>maven-api-plugin-processor</artifactId>
              <version>${mavenVersion}</version>
            </path>
            <path>
              <groupId>org.apache.maven</groupId>
              <artifactId>maven-api-di</artifactId>
              <version>${mavenVersion}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Amaven.plugin.groupId=org.apache.maven.its.mng12534</arg>
            <arg>-Amaven.plugin.artifactId=mng12534-plugin</arg>
            <arg>-Amaven.plugin.version=1.0-SNAPSHOT</arg>
            <arg>-Amaven.plugin.goalPrefix=mng12534</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
