<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.its.prerelease</groupId>
  <artifactId>test</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <name>Maven Integration Test :: unversioned plugin must not resolve to a pre-release</name>
  <description>
    Declares a plugin without a version. The plugin repository offers a stable 1.0 and a
    pre-release 2.0-beta-1, and its metadata names the pre-release as the RELEASE version --
    exactly the situation Maven Central produces while a plugin's next major line is still in
    beta. Maven must select the stable version.
  </description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.its.prerelease</groupId>
        <artifactId>maven-it-plugin-prerelease</artifactId>
        <!-- deliberately no version -->
        <executions>
          <execution>
            <id>touch</id>
            <phase>validate</phase>
            <goals>
              <goal>touch</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
