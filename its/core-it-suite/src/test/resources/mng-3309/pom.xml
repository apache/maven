<project xmlns="http://maven.apache.org/POM/4.1.0">
  <modelVersion>4.1.0</modelVersion>

  <groupId>org.apache.maven.its.mng3309</groupId>
  <artifactId>cascading-profiles</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Maven Integration Test :: MNG-3309</name>
  <description>
    Test cascading profile activation: a profile's properties can trigger
    the activation of subsequent profiles within the same POM.
  </description>

  <profiles>
    <!-- Profile 1: activated by user property, sets cascade.step1 -->
    <profile>
      <id>trigger</id>
      <activation>
        <condition>${start.cascade} == 'true'</condition>
      </activation>
      <properties>
        <cascade.step1>activated</cascade.step1>
      </properties>
    </profile>

    <!-- Profile 2: cascades from profile 1 via cascade.step1, sets cascade.step2 -->
    <profile>
      <id>step1</id>
      <activation>
        <condition>${cascade.step1} == 'activated'</condition>
      </activation>
      <properties>
        <cascade.step2>activated</cascade.step2>
      </properties>
    </profile>

    <!-- Profile 3: cascades from profile 2 via cascade.step2 -->
    <profile>
      <id>step2</id>
      <activation>
        <condition>${cascade.step2} == 'activated'</condition>
      </activation>
      <properties>
        <cascade.final>reached</cascade.final>
      </properties>
    </profile>

    <!-- Profile 4: should NOT activate (nothing sets cascade.unrelated) -->
    <profile>
      <id>unrelated</id>
      <activation>
        <condition>${cascade.unrelated} == 'true'</condition>
      </activation>
      <properties>
        <cascade.unrelated.result>should-not-appear</cascade.unrelated.result>
      </properties>
    </profile>
  </profiles>
</project>
