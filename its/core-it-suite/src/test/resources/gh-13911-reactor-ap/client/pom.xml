<project xmlns="http://maven.apache.org/POM/4.1.0">
  <parent>
    <groupId>org.apache.maven.its.gh13911</groupId>
    <artifactId>aggregator</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>client</artifactId>
  <packaging>jar</packaging>

  <name>Maven Integration Test :: GH-13911 :: Client (uses reactor AP)</name>
  <description>Uses the annotation processor built from source in the sibling module.
    The processor dependency triggers Maven's reactor ordering so the processor
    is compiled before this module's compile phase runs.</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven.its.gh13911</groupId>
      <artifactId>processor</artifactId>
      <version>1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            Explicit annotationProcessorPaths is the recommended modern approach.
            The reactor-built processor artifact is resolved from target/classes via the
            workspace reader (no install phase required), so the dependency ordering
            created by the provided-scope dep above is sufficient.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.apache.maven.its.gh13911</groupId>
              <artifactId>processor</artifactId>
              <version>1.0-SNAPSHOT</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
