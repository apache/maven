<project xmlns="http://maven.apache.org/POM/4.1.0" root="true">
  <groupId>org.apache.maven.its.gh13911</groupId>
  <artifactId>aggregator</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Maven Integration Test :: GH-13911 :: Reactor Annotation Processor</name>
  <description>Verifies that an annotation processor built in the same Maven reactor can be used by a sibling
    module during its compile phase — with both the sequential and concurrent builders.</description>

  <properties>
    <!--
      Keep release=11 for a sensible baseline (annotation processor API uses RELEASE_8 enum constant
      which is available since Java 8; using RELEASE_11 as the compilation target is fine here because
      the IT harness runs with JDK 11+).
    -->
    <maven.compiler.release>11</maven.compiler.release>
  </properties>

  <subprojects>
    <subproject>processor</subproject>
    <subproject>client</subproject>
  </subprojects>
</project>
