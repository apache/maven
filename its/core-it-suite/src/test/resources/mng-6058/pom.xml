<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.its.mng6058</groupId>
  <artifactId>test</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <name>Maven Integration Test :: MNG-6058</name>
  <description>Verify that a test dependency overrides a transitive dependency of the application only for the
    test classpath: a:2.0 needs b:2.0 while the project declares b:1.0 with test scope.</description>

  <dependencies>
    <dependency>
      <groupId>org.apache.maven.its.mng6058</groupId>
      <artifactId>a</artifactId>
      <version>2.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.its.mng6058</groupId>
      <artifactId>b</artifactId>
      <version>1.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.its.plugins</groupId>
        <artifactId>maven-it-plugin-dependency-resolution</artifactId>
        <version>2.1-SNAPSHOT</version>
        <configuration>
          <significantPathLevels>1</significantPathLevels>
        </configuration>
        <executions>
          <!-- the graph of a mojo must not depend on the mojos running before or after it -->
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compileClassPath>target/compile.txt</compileClassPath>
            </configuration>
          </execution>
          <execution>
            <id>test</id>
            <phase>process-resources</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <testClassPath>target/test.txt</testClassPath>
            </configuration>
          </execution>
          <execution>
            <id>runtime</id>
            <phase>process-classes</phase>
            <goals>
              <goal>runtime</goal>
            </goals>
            <configuration>
              <runtimeClassPath>target/runtime.txt</runtimeClassPath>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
