<!--
  Parent POM for the mvnval bundle workspace reader IT.
  Lives in a sibling directory next to the child so that no filesystem-based
  parent discovery (relativePath) can link them: only the bundle workspace
  reader installed by mvnval can resolve this parent when the child is
  validated together with it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.its.mvnval</groupId>
  <artifactId>bundle-parent</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
</project>
