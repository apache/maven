<project xmlns="http://maven.apache.org/POM/4.1.0">
    <groupId>org.apache.maven.tests</groupId>
    <artifactId>resolved-model-with-profiles</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <pom.declared.prop>hello</pom.declared.prop>
    </properties>
    <profiles>
        <profile>
            <id>file-condition</id>
            <activation>
                <file>
                    <exists>${some.dir}</exists>
                </file>
            </activation>
            <properties>
                <profile.file>activated</profile.file>
            </properties>
        </profile>
        <profile>
            <id>property-condition</id>
            <activation>
                <property>
                    <name>some.gating.property</name>
                </property>
            </activation>
            <properties>
                <profile.property>activated</profile.property>
            </properties>
        </profile>
        <profile>
            <id>condition-condition</id>
            <activation>
                <condition>${some.condition.property} == 'true'</condition>
            </activation>
            <properties>
                <profile.condition>activated</profile.condition>
            </properties>
        </profile>
        <!-- missing()-condition profile: must NOT fire in CONSUMER_DEPENDENCY builds -->
        <!-- missing() = !exists() and in the sandbox exists() always returns false,  -->
        <!-- so missing() would always return true — this profile must be pre-filtered. -->
        <profile>
            <id>missing-condition</id>
            <activation>
                <condition>missing('/publisher/private/file')</condition>
            </activation>
            <properties>
                <profile.missing.condition>activated</profile.missing.condition>
            </properties>
        </profile>
        <!-- POM-declared property activation: suppressed in external builds (see #13390) -->
        <profile>
            <id>pom-declared-property-condition</id>
            <activation>
                <property>
                    <name>pom.declared.prop</name>
                </property>
            </activation>
            <properties>
                <profile.pom.property>activated</profile.pom.property>
            </properties>
        </profile>
        <!-- POM-declared property via <condition>: must also be suppressed in external builds (#13390).
             ConditionProfileActivator.doGetProperty() calls context.getModelProperty() directly,
             so the sandbox must override getModelProperty() to return null. -->
        <profile>
            <id>pom-declared-property-via-condition</id>
            <activation>
                <condition>${pom.declared.prop} == 'hello'</condition>
            </activation>
            <properties>
                <profile.pom.condition>activated</profile.pom.condition>
            </properties>
        </profile>
        <!-- default-on profile: fires when 'skip.defaults' is absent; suppressed when set as system property -->
        <profile>
            <id>negated-property-default-on</id>
            <activation>
                <property>
                    <name>!skip.defaults</name>
                </property>
            </activation>
            <properties>
                <profile.negated.property>activated</profile.negated.property>
            </properties>
        </profile>
        <profile>
            <id>jdk-condition</id>
            <activation>
                <jdk>[1,)</jdk>
            </activation>
            <properties>
                <profile.jdk>activated</profile.jdk>
            </properties>
            <repositories>
                <repository>
                    <id>profile-repo</id>
                    <url>https://repo.example.test/profile</url>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>
