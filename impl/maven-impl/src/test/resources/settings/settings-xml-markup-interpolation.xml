<!--
  Settings file that uses a property whose value contains XML special characters
  (e.g. &, <, >) to verify that interpolateSource() XML-escapes resolved values
  before substituting them into the raw XML string (MNG-4625 regression test).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>xml-markup</id>
      <properties>
        <!-- test.prop value is "&x=y<>" (raw, contains XML special characters) -->
        <jdbcUrl>${test.prop}</jdbcUrl>
      </properties>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>xml-markup</activeProfile>
  </activeProfiles>
</settings>
